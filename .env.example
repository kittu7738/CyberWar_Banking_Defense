# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Optional - In-memory synthetic store active if unset)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberwar_defense
PGUSER=postgres
PGHOST=localhost
PGDATABASE=cyberwar_defense
PGPASSWORD=postgres
PGPORT=5432

# Redis Configuration (Optional - for real-time pub/sub caching)
REDIS_URL=redis://localhost:6379

# Simulation Parameters
DEFAULT_DEFENSE_BUDGET=1000000
MAX_SIMULATION_ROUNDS=5
